APP_NAME="Campus — Placement & Career Intelligence"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Campus/public
APP_KEY=replace-with-a-long-random-local-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_campus_portal
DB_USER=root
DB_PASS=
DB_TIMEZONE=+05:30
APP_TIMEZONE=Asia/Kolkata
SESSION_SECURE=false

# --- Optional AI provider -----------------------------------------------------
# Campus never requires an external model. Leave AI_ENABLED=false and every
# AI-touchpoint (copilot, resume wording, job-description draft) uses the
# deterministic rule engine instead. The key is read server-side only; it is
# never written to HTML, JavaScript or the repository.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=12
